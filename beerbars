from concurrent.futures import ThreadPoolExecutor, wait, FIRST_COMPLETED
from pathlib import Path
from lxml import etree
from weasyprint import HTML
import time


# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------
INPUT_DIR = Path("/path/to/xmls")
XSLT_PATH = Path("/path/to/stylesheet.xsl")
OUTPUT_DIR = Path("/path/to/pdfs")

MAX_WORKERS = 8
CHUNK_SIZE = 3000


# Create output directory if it does not already exist
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)


def processXml(xmlPath):
    """
    Processes one XML file:
        XML -> XSLT -> HTML -> PDF

    Returns:
        filename
        success/failure
        processing time
        error message
    """

    startTime = time.perf_counter()

    try:
        # Parse and compile XSLT for this worker task
        transform = etree.XSLT(
            etree.parse(str(XSLT_PATH))
        )

        # Parse XML
        xmlTree = etree.parse(str(xmlPath))

        # Apply XSLT transformation
        htmlResult = transform(xmlTree)

        # Use same filename as XML, but change extension to .pdf
        pdfFile = OUTPUT_DIR / (xmlPath.stem + ".pdf")

        # Convert generated HTML to PDF
        HTML(
            string=str(htmlResult)
        ).write_pdf(
            str(pdfFile)
        )

        elapsedTime = time.perf_counter() - startTime

        return (
            xmlPath.name,
            True,
            elapsedTime,
            None
        )

    except Exception as e:
        elapsedTime = time.perf_counter() - startTime

        return (
            xmlPath.name,
            False,
            elapsedTime,
            repr(e)
        )


def main():

    startAll = time.perf_counter()

    ok = 0
    err = 0
    processed = 0

    # Stream files instead of loading millions of filenames into memory
    xmlFiles = INPUT_DIR.glob("*.xml")

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:

        futures = set()

        for xmlPath in xmlFiles:

            # Submit XML for processing
            future = executor.submit(
                processXml,
                xmlPath
            )

            futures.add(future)

            # Prevent millions of futures from accumulating in memory
            if len(futures) >= CHUNK_SIZE:

                done, futures = wait(
                    futures,
                    return_when=FIRST_COMPLETED
                )

                for future in done:

                    xmlFilename, success, elapsedTime, errorMessage = (
                        future.result()
                    )

                    processed += 1

                    if success:
                        ok += 1

                        print(
                            "OK {} ({:.3f}s)".format(
                                xmlFilename,
                                elapsedTime
                            )
                        )

                    else:
                        err += 1

                        print(
                            "ERR {} ({:.3f}s): {}".format(
                                xmlFilename,
                                elapsedTime,
                                errorMessage
                            )
                        )

                    # Progress update
                    if processed % 10000 == 0:

                        elapsedAll = (
                            time.perf_counter() - startAll
                        )

                        rate = (
                            processed / elapsedAll
                            if elapsedAll
                            else 0
                        )

                        print(
                            "Processed: {} | OK: {} | ERR: {} | Rate: {:.1f} files/sec"
                            .format(
                                processed,
                                ok,
                                err,
                                rate
                            )
                        )

        # Finish remaining files
        while futures:

            done, futures = wait(
                futures,
                return_when=FIRST_COMPLETED
            )

            for future in done:

                xmlFilename, success, elapsedTime, errorMessage = (
                    future.result()
                )

                processed += 1

                if success:
                    ok += 1

                    print(
                        "OK {} ({:.3f}s)".format(
                            xmlFilename,
                            elapsedTime
                        )
                    )

                else:
                    err += 1

                    print(
                        "ERR {} ({:.3f}s): {}".format(
                            xmlFilename,
                            elapsedTime,
                            errorMessage
                        )
                    )

    totalTime = time.perf_counter() - startAll

    rate = (
        processed / totalTime
        if totalTime
        else 0
    )

    print("\n=== Final Summary ===")
    print("Processed: {}".format(processed))
    print("Success:   {}".format(ok))
    print("Failed:    {}".format(err))
    print("Total time: {:.2f}s".format(totalTime))
    print("Rate: {:.1f} files/sec".format(rate))


if __name__ == "__main__":
    main()
